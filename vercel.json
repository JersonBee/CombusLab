{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build --prefix Changeme_Nasa/dashboard",
  "installCommand": "npm ci --prefix Changeme_Nasa && npm ci --prefix Changeme_Nasa/dashboard",
  "outputDirectory": "Changeme_Nasa/dashboard/dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api(?:/.*)?", "dest": "/api/router" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
